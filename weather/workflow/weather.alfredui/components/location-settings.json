[
  {
    "id": "mode",
    "type": "label",
    "text": "Approximate current location or your saved city",
    "font": {
      "size": 13
    }
  },
  {
    "type": "view",
    "layout": "inline",
    "spacing": 8,
    "components": [
      {
        "id": "city",
        "type": "textfield",
        "text": "Dublin, Ireland",
        "placeholder": "City, country",
        "constraints": {
          "size": {
            "width": 220
          }
        },
        "accessibility": {
          "label": "Saved city"
        }
      },
      {
        "id": "use-city",
        "type": "button",
        "text": "Use city",
        "events": [
          {
            "triggers": "actioned",
            "action": [
              {
                "type": "json",
                "src": {
                  "update": {
                    "ids": {
                      "city": {
                        "enabled": false
                      },
                      "use-city": {
                        "enabled": false
                      },
                      "automatic": {
                        "enabled": false
                      },
                      "refresh": {
                        "enabled": false
                      },
                      "status": {
                        "components": [
                          {
                            "type": "label",
                            "text": "Updating weather…",
                            "font": {
                              "size": 12
                            },
                            "colour": "secondaryLabelColor"
                          }
                        ]
                      },
                      "settings": {
                        "enabled": false
                      },
                      "temperature-unit": {
                        "enabled": false
                      },
                      "apply-settings": {
                        "enabled": false
                      },
                      "settings-error": {
                        "components": [
                          {
                            "type": "label",
                            "text": "Updating location…",
                            "font": {
                              "size": 12
                            },
                            "colour": "secondaryLabelColor"
                          }
                        ]
                      }
                    }
                  }
                }
              },
              {
                "type": "script",
                "src": "scripts/weather.py",
                "args": [
                  "city",
                  "{value:city.text}"
                ],
                "async": true
              }
            ]
          }
        ]
      },
      {
        "id": "automatic",
        "type": "button",
        "text": "Current area",
        "events": [
          {
            "triggers": "actioned",
            "action": [
              {
                "type": "json",
                "src": {
                  "update": {
                    "ids": {
                      "city": {
                        "enabled": false
                      },
                      "use-city": {
                        "enabled": false
                      },
                      "automatic": {
                        "enabled": false
                      },
                      "refresh": {
                        "enabled": false
                      },
                      "status": {
                        "components": [
                          {
                            "type": "label",
                            "text": "Updating weather…",
                            "font": {
                              "size": 12
                            },
                            "colour": "secondaryLabelColor"
                          }
                        ]
                      },
                      "settings": {
                        "enabled": false
                      },
                      "temperature-unit": {
                        "enabled": false
                      },
                      "apply-settings": {
                        "enabled": false
                      },
                      "settings-error": {
                        "components": [
                          {
                            "type": "label",
                            "text": "Updating location…",
                            "font": {
                              "size": 12
                            },
                            "colour": "secondaryLabelColor"
                          }
                        ]
                      }
                    }
                  }
                }
              },
              {
                "type": "script",
                "src": "scripts/weather.py",
                "args": [
                  "automatic"
                ],
                "async": true
              }
            ]
          }
        ]
      }
    ]
  }
]
