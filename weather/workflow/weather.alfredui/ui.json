{
  "bundleid": "net.ninjakitty.weather",
  "iconpath": "../icon.png",
  "window": {
    "title": "Weather",
    "padding": 18,
    "root": {
      "type": "view",
      "layout": "inline",
      "direction": "vertical",
      "spacing": 14,
      "events": [
        {
          "triggers": "launched",
          "action": [
            {
              "type": "json",
              "src": {
                "update": {
                  "ids": {
                    "refresh": {
                      "enabled": false
                    },
                    "status": {
                      "components": [
                        {
                          "type": "label",
                          "text": "Updating weather…",
                          "font": {
                            "size": 12
                          },
                          "colour": "secondaryLabelColor"
                        }
                      ]
                    },
                    "settings": {
                      "enabled": false
                    }
                  }
                }
              }
            },
            {
              "type": "script",
              "src": "scripts/weather.py",
              "args": [
                "load"
              ],
              "async": true
            }
          ]
        }
      ],
      "components": [
        {
          "id": "location",
          "type": "label",
          "text": "Weather",
          "font": {
            "size": 17,
            "weight": "semibold"
          }
        },
        {
          "type": "view",
          "layout": "border",
          "padding": 16,
          "cornerradius": 14,
          "background": "#80808018",
          "components": [
            {
              "type": "view",
              "layout": "inline",
              "direction": "vertical",
              "spacing": 4,
              "constraints": {
                "region": "left"
              },
              "components": [
                {
                  "id": "summary-heading",
                  "type": "label",
                  "text": "",
                  "font": {
                    "size": 12
                  },
                  "colour": "secondaryLabelColor"
                },
                {
                  "type": "view",
                  "layout": "inline",
                  "spacing": 8,
                  "components": [
                    {
                      "id": "summary-icon",
                      "type": "view",
                      "layout": "inline",
                      "components": []
                    },
                    {
                      "id": "summary",
                      "type": "label",
                      "text": "—",
                      "font": {
                        "size": 42,
                        "weight": "medium"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "details",
              "type": "label",
              "text": "",
              "font": {
                "size": 16,
                "weight": "medium"
              },
              "constraints": {
                "region": "right",
                "position": "centre"
              },
              "colour": "secondaryLabelColor"
            }
          ]
        },
        {
          "type": "view",
          "layout": "inline",
          "direction": "vertical",
          "spacing": 8,
          "components": [
            {
              "id": "hourly-heading",
              "type": "label",
              "text": "Rest of the day",
              "font": {
                "size": 12,
                "weight": "bold"
              },
              "colour": "secondaryLabelColor",
              "constraints": {
                "insets": {
                  "left": 12
                }
              }
            },
            {
              "id": "hourly",
              "type": "view",
              "layout": "grid",
              "cols": 3,
              "rows": 1,
              "spacing": 10,
              "components": []
            }
          ]
        },
        {
          "type": "view",
          "layout": "inline",
          "direction": "vertical",
          "spacing": 8,
          "components": [
            {
              "id": "daily-heading",
              "type": "label",
              "text": "3-day forecast",
              "font": {
                "size": 12,
                "weight": "bold"
              },
              "colour": "secondaryLabelColor",
              "constraints": {
                "insets": {
                  "left": 12
                }
              }
            },
            {
              "id": "daily",
              "type": "view",
              "layout": "inline",
              "spacing": 8,
              "components": [],
              "direction": "vertical",
              "padding": 12,
              "cornerradius": 12,
              "background": "#80808018"
            }
          ]
        },
        {
          "type": "view",
          "layout": "border",
          "spacing": 8,
          "components": [
            {
              "id": "refresh",
              "type": "button",
              "text": "Refresh",
              "events": [
                {
                  "triggers": "actioned",
                  "action": [
                    {
                      "type": "json",
                      "src": {
                        "update": {
                          "ids": {
                            "refresh": {
                              "enabled": false
                            },
                            "status": {
                              "components": [
                                {
                                  "type": "label",
                                  "text": "Updating weather…",
                                  "font": {
                                    "size": 12
                                  },
                                  "colour": "secondaryLabelColor"
                                }
                              ]
                            },
                            "settings": {
                              "enabled": false
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "script",
                      "src": "scripts/weather.py",
                      "args": [
                        "refresh"
                      ],
                      "async": true
                    }
                  ]
                }
              ],
              "constraints": {
                "region": "left",
                "insets": {
                  "left": 10
                }
              },
              "bordered": false
            },
            {
              "id": "status",
              "type": "view",
              "layout": "inline",
              "direction": "vertical",
              "components": [],
              "constraints": {
                "region": "centre",
                "position": "centre"
              }
            },
            {
              "id": "settings",
              "type": "button",
              "text": "",
              "bordered": false,
              "image": {
                "type": "symbol",
                "src": "gearshape"
              },
              "tooltip": "Weather settings",
              "accessibility": {
                "label": "Settings"
              },
              "events": [
                {
                  "triggers": "actioned",
                  "action": {
                    "type": "script",
                    "src": "scripts/weather.py",
                    "args": [
                      "config"
                    ]
                  }
                }
              ],
              "constraints": {
                "region": "right"
              }
            }
          ]
        }
      ]
    }
  }
}
