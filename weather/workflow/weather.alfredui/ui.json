{
  "bundleid": "net.ninjakitty.weather",
  "iconpath": "../icon.png",
  "window": {
    "title": "Weather",
    "padding": 12,
    "root": {
      "type": "view",
      "layout": "inline",
      "direction": "vertical",
      "spacing": 6,
      "events": [
        {
          "triggers": "launched",
          "action": [
            {
              "type": "json",
              "src": {
                "update": {
                  "ids": {
                    "refresh": {
                      "enabled": false
                    },
                    "status": {
                      "text": "Loading weather…",
                      "hidden": false,
                      "colour": "secondaryLabelColor"
                    },
                    "settings": {
                      "enabled": false
                    }
                  }
                }
              }
            },
            {
              "type": "script",
              "src": "scripts/weather.py",
              "args": [
                "load"
              ],
              "async": true
            }
          ]
        }
      ],
      "components": [
        {
          "id": "location",
          "type": "label",
          "text": "Weather",
          "font": {
            "size": 23
          }
        },
        {
          "id": "status",
          "type": "label",
          "text": "Loading weather…",
          "font": {
            "size": 13
          }
        },
        {
          "id": "summary-heading",
          "type": "label",
          "text": "",
          "font": {
            "size": 13
          }
        },
        {
          "id": "summary",
          "type": "label",
          "text": "—",
          "font": {
            "size": 32
          }
        },
        {
          "id": "details",
          "type": "label",
          "text": "",
          "font": {
            "size": 13
          },
          "constraints": {
            "insets": {
              "bottom": 12
            }
          }
        },
        {
          "id": "hourly-heading",
          "type": "label",
          "text": "Rest of the day",
          "font": {
            "size": 16
          }
        },
        {
          "id": "hourly",
          "type": "view",
          "layout": "grid",
          "cols": 3,
          "rows": 1,
          "spacing": 16,
          "components": [],
          "constraints": {
            "insets": {
              "bottom": 12
            }
          }
        },
        {
          "id": "daily-heading",
          "type": "label",
          "text": "3-day forecast",
          "font": {
            "size": 16
          }
        },
        {
          "id": "daily",
          "type": "view",
          "layout": "grid",
          "cols": 4,
          "rows": 4,
          "spacing": 8,
          "components": [],
          "constraints": {
            "insets": {
              "bottom": 12
            }
          }
        },
        {
          "type": "view",
          "layout": "border",
          "spacing": 8,
          "components": [
            {
              "id": "refresh",
              "type": "button",
              "text": "Refresh",
              "events": [
                {
                  "triggers": "actioned",
                  "action": [
                    {
                      "type": "json",
                      "src": {
                        "update": {
                          "ids": {
                            "refresh": {
                              "enabled": false
                            },
                            "status": {
                              "text": "Loading weather…",
                              "hidden": false,
                              "colour": "secondaryLabelColor"
                            },
                            "settings": {
                              "enabled": false
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "script",
                      "src": "scripts/weather.py",
                      "args": [
                        "refresh"
                      ],
                      "async": true
                    }
                  ]
                }
              ],
              "constraints": {
                "region": "left"
              }
            },
            {
              "id": "settings",
              "type": "button",
              "text": "",
              "bordered": false,
              "image": {
                "type": "symbol",
                "src": "gearshape"
              },
              "tooltip": "Weather settings",
              "accessibility": {
                "label": "Settings"
              },
              "events": [
                {
                  "triggers": "actioned",
                  "action": {
                    "type": "script",
                    "src": "scripts/weather.py",
                    "args": [
                      "config"
                    ]
                  }
                }
              ],
              "constraints": {
                "region": "right"
              }
            }
          ]
        }
      ]
    }
  }
}
