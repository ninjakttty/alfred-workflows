#!/bin/zsh
set -eu
command_name="${1:-toggle}"
if (( $# > 1 )); then print -u2 'Usage: scratchpad [toggle|show|hide|quit]'; exit 2; fi
case "$command_name" in
  toggle|show|hide|quit) ;;
  *) print -u2 'Usage: scratchpad [toggle|show|hide|quit]'; exit 2 ;;
esac
app="${0:A:h}/.scratchpad/Scratchpad.app"
if [[ ! -d "$app" ]]; then print -u2 "Bundled Scratchpad is missing at $app"; exit 1; fi
"$app/Contents/MacOS/Scratchpad" --prepare-launch "$app"
# Launch Services routes URL events to the existing process; never use open -n.
exec /usr/bin/open -g -a "$app" "ninjakitty-scratchpad://$command_name"
